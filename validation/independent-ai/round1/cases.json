        "tasks": [
          {"id":"A","name":"Common preparation","duration":2,"remainingDays":2,"predecessors":[],"costPerDay":100,"fixedCost":10},
          {"id":"B","name":"Short branch","duration":3,"remainingDays":3,"predecessors":["A"],"costPerDay":200,"fixedCost":20},
          {"id":"C","name":"Long branch","duration":5,"remainingDays":5,"predecessors":["A"],"costPerDay":50,"fixedCost":30},
